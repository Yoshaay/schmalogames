<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron/V8 braucht JIT und unsignierten Speicher -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Native Module (grandi.node, libndi.dylib) sind nicht mit unserer Team-ID gebaut -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- NDI: eingehende Verbindungen vom Ü-Wagen, Netzwerk-Discovery -->
  <key>com.apple.security.network.server</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Applausometer nutzt das Mikrofon -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
